generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model jobs {
  id           BigInt @id @default(autoincrement())
  queue        String @db.VarChar(255)
  payload      String
  attempts     Int    @db.SmallInt
  reserved_at  Int?
  available_at Int
  created_at   Int

  @@index([queue], map: "jobs_queue_index")
}

model migrations {
  id        Int    @id @default(autoincrement())
  migration String @db.VarChar(255)
  batch     Int
}

model tb_admin {
  id_admin       Int    @id @default(autoincrement())
  username_admin String @db.VarChar(255)
  password_admin String @db.VarChar(255)
}

model tb_barang {
  id_barang        Int       @id @default(autoincrement())
  id_kategori      Int
  nama_barang      String    @db.VarChar(255)
  deskripsi_barang String    @db.VarChar(255)
  harga_barang     String    @db.VarChar(255)
  stok_barang      Int
  foto_barang      String    @db.VarChar(255)
  created_at       DateTime? @default(now()) @db.Timestamp(6)
}

model tb_detail_pesanan {
  id_detail      Int    @id @default(autoincrement())
  id_pesanan     String @db.VarChar(255)
  id_barang      Int
  jumlah_pesanan Int
  subtotal_harga String @db.VarChar(255)
}

model tb_kategori {
  id_kategori   Int    @id @default(autoincrement())
  nama_kategori String @db.VarChar(255)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model tb_meja {
  id_meja    Int       @id @default(autoincrement())
  kode_meja  String    @unique(map: "tb_meja_kode_meja_unique") @db.VarChar(255)
  nama_meja  String    @db.VarChar(255)
  token_qr   String    @unique(map: "tb_meja_token_qr_unique") @db.VarChar(255)
  status     String    @default("ACTIVE") @db.VarChar(255)
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model tb_pesanan {
  id_pesanan          String   @id @db.VarChar(255)
  nama_pesanan        String   @db.VarChar(255)
  alamat_pesanan      String   @db.VarChar(255)
  no_hp_pesanan       String   @db.VarChar(255)
  email_pesanan       String   @db.VarChar(255)
  total_harga_pesanan String   @db.VarChar(255)
  status_pesanan      String   @default("Menunggu Pembayaran") @db.VarChar(255)
  tanggal_pesanan     DateTime @db.Date
  jenis_pembayaran    String   @db.VarChar(255)
  snap_token          String?  @db.VarChar(255)
  id_meja             Int?
  bukti_pembayaran    String?
}
